# Postgres connection string (Neon / Render Postgres / local)
DATABASE_URL=postgres://user:password@localhost:5432/japanhiu
# Password for /admin
ADMIN_PASSWORD=change-me-to-a-long-password
# Optional: signing secret for admin session cookies (defaults to a hash of ADMIN_PASSWORD)
SESSION_SECRET=
# Optional, not used yet (reserved for future search/category pulls)
ZENROWS_API_KEY=
# Optional
PORT=3000
